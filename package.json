{
  "name": "@chaostar/paperclip-zh-cn",
  "version": "0.2.2",
  "description": "Simplified Chinese UI localization for Paperclip",
  "type": "module",
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/While-Shark/Paperclipai-zh-cn.git"
  },
  "homepage": "https://github.com/While-Shark/Paperclipai-zh-cn#readme",
  "bugs": {
    "url": "https://github.com/While-Shark/Paperclipai-zh-cn/issues"
  },
  "keywords": [
    "paperclip",
    "paperclipai",
    "plugin",
    "localization",
    "zh-cn",
    "simplified-chinese"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "coverage": "tsx scripts/report-coverage.mts",
    "extract": "node scripts/extract-ui-text.mjs && node scripts/prepare-ui-candidates.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {}
}
